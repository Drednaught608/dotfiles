# Bash only: other readline programs (python, psql, gdb) read this file too
$if Bash
"\C-l": "\C-e\C-u clear\C-m"
"\C-g": "\C-e\C-u git_diff\C-m"
"\C-h": "\C-e\C-u git_log\C-m"
"\C-n": "\C-e\C-u git switch "
"\C-o": "\C-e\C-u git_status\C-m"
"\C-p": "\C-e\C-u git_sync\C-m"
"\C-r": "\C-e\C-u git_fetch\C-m"
"\C-t": "\C-e\C-u git_tracked\C-m"
"\C-_": "\C-e\C-u git_branches\C-m"
"\C-]": "\C-e\C-u git_commit\C-m"
$endif
