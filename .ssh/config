Host github.com
  User git
  IdentityFile ~/.ssh/id_ed25519

# Tailscale machines. The tailnet already encrypts these connections and
# vouches for each machine, so skip ssh's own host-key check, which would
# otherwise trip every time one of them is reinstalled. Each short name
# connects to its full MagicDNS name (%h is the name you typed), which only
# resolves through Tailscale, so it can never reach some other machine.
Host minipc desktop framework minipc-linux desktop-linux framework-linux
  HostName %h.taila750a7.ts.net
  User michael
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR

# Defaults for every host. ssh uses the first value it finds for each
# option, so this block goes last, where any host above can override it.
Host *
  StrictHostKeyChecking accept-new
