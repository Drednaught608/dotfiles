#!/usr/bin/env bash
# Regression tests for dgit. Uses throwaway homes in a temp dir; never
# touches your real $HOME or global git config. Run it with: dgit test, which
# makes that temp dir, and tidies up after this however it stops.

# dgit runs with the Bash running this ($BASH), not whichever its #! line finds,
# so "/bin/bash dgit test" tests it under macOS's built-in Bash 3.2.
D=$(cd "$(dirname "$0")/.." && pwd)/dgit
T=$DGIT_TEST_DIR
[ -n "$T" ] && [ -d "$T" ] || { echo "dgit-test: run it with: dgit test" >&2; exit 2; }
# clock: the time in microseconds, in $now, for timing sections. Bash 5 has a
# clock built in; older Bash (macOS's 3.2) only counts whole seconds, so perl
# (which macOS has) gives finer ones, and with no perl, whole seconds it is.
if [ -n "$EPOCHREALTIME" ]; then
  clock() { now=${EPOCHREALTIME//[!0-9]/}; }
elif command -v perl > /dev/null; then
  clock() { now=$(perl -MTime::HiRes=time -e 'printf "%.0f", time * 1e6'); }
else
  clock() { now=$((SECONDS * 1000000)); }
fi
export GIT_CONFIG_GLOBAL=$T/gitconfig GIT_CONFIG_NOSYSTEM=1
unset DGIT_DIR XDG_DATA_HOME
git config --global user.name t; git config --global user.email t@t
git config --global init.defaultBranch main
git config --global help.format man  # so "--help" tests never open a web browser
git config --global alias.up pull; git config --global alias.aa 'add -A'
git config --global alias.sh '!echo hi'; git config --global alias.untrack 'rm --cached'
git config --global alias.shstat '!git status'; git config --global alias.shlist '!git config --get-regexp ^alias\.'
echo '*.secret' > "$T/global-ignore"; git config --global core.excludesFile "$T/global-ignore"

pass=0 fail=0
ok() { if eval "$2"; then pass=$((pass+1)); else fail=$((fail+1)); fails+="          $1"$'
'; fi; live; }
dg() { "$BASH" "$D" "$@" 2>&1; }
# within <seconds> <command...>: run it, stopping it if it takes longer (timeout(1)
# isn't on macOS)
within() {
  local s=$1 p w r
  shift
  "$@" & p=$!
  ( sleep "$s"; kill "$p" 2> /dev/null ) & w=$!
  wait "$p"; r=$?
  kill "$w" 2> /dev/null; wait "$w" 2> /dev/null
  return $r
}

# Sections: section "<name>" <count> starts one, and says how many tests it has.
# Adding or removing a test means updating that count: a section whose count
# doesn't match the tests that ran fails, and says what to change it to.
#
# Progress: each section prints one line when it finishes: which section of how
# many, its passed/total tests and how long it took, with any failed tests listed
# under it. On a terminal, a live line under them shows the section running now,
# passed out of its count, updated after each test, and colours are used. Each
# redraw is a single write that leaves the cursor at the start of the live line.
if [ -t 1 ]; then tty=1 c_ok=$'\e[32m' c_bad=$'\e[31m' c_run=$'\e[33m' c_bold=$'\e[1m' c_off=$'\e[0m'
else tty= c_ok= c_bad= c_run= c_bold= c_off=; fi
nsec=$(grep -c '^section "[^"]' "$0") isec=0  # sections in this file, and how many have finished
sec= count= sp=0 sf=0 st=0 fails= miscounts=0
# line <status> <colour> <out of>: the current section's line as it stands now, in $sline
line() {
  local now ms
  clock
  ms=$(( (now - st) / 1000 ))
  printf -v sline '  %s%s%s  [%0*d/%d]  %-46s %3d/%-3d %3d.%02ds' "$2" "$1" "$c_off" ${#nsec} $((isec + 1)) $nsec \
    "$sec" $((pass - sp)) "$3" $((ms / 1000)) $((ms % 1000 / 10))
}
# live: redraw the live line at the bottom, in one write (only on a terminal, while a section runs)
live() { [ -n "$tty" ] && [ -n "$sec" ] && { line 'RUN ' "$c_run" "$count"; printf '\r\e[K%s\r' "$sline"; }; }
section() {
  local ran=$((pass - sp + fail - sf))
  if [ -n "$sec" ]; then
    if [ "$ran" != "$count" ]; then
      fails+="          ${c_bad}The section says $count tests, but $ran ran: change its count, to read: section \"$sec\" $ran${c_off}"$'\n'
      miscounts=$((miscounts + 1))
    fi
    if [ $((fail - sf)) -eq 0 ] && [ "$ran" = "$count" ]; then line PASS "$c_ok" "$ran"; else line FAIL "$c_bad" "$ran"; fi
    if [ -n "$tty" ]; then printf '\r\e[K%s\n' "$sline"; else printf '%s\n' "$sline"; fi  # In the live line's place
    printf '%s' "$fails"
    isec=$((isec + 1))
  elif [ -n "$tty" ]; then
    printf '\r\e[K'  # The end: clear the live line for the summary
  fi
  clock
  sec=$1 count=$2 sp=$pass sf=$fail st=$now fails=
  if [ -n "$sec" ] && [[ ! $count =~ ^[0-9]+$ ]]; then
    echo "${c_bad}dgit-test: section \"$sec\" needs its test count, as: section \"$sec\" <count>${c_off}" >&2
    exit 2
  fi
  live
}

echo "${c_bold}Dotfiles Git (dgit) test suite${c_off}"
echo "Runs in throwaway homes under $T, removed when done."
echo "Your real ~, dgit repo and git config are never used."
echo

mkdir -p "$T/a/.config/nvim" "$T/a/proj" "$T/b" "$T/out"
git init -q --bare "$T/r.git"
export HOME=$T/a
echo b > "$HOME/.bashrc"; echo n > "$HOME/.config/nvim/init.lua"
echo l > "$HOME/.config/nvim/lazy.json"; echo junk > "$HOME/junk"

section "Init and repo location" 5
dg init >/dev/null
ok "ignore rule in place on first use" 'dg status >/dev/null; [ "$(cat "$HOME/.local/share/dgit/ignore")" = "*" ]'
ok "init twice refused" '! dg init >/dev/null'
ok "repo lives in ~/.local/share/dgit" '[ -f "$HOME/.local/share/dgit/HEAD" ] && [ ! -e "$HOME/.dgit" ]'
mkdir "$T/x1" "$T/x2"
ok "XDG_DATA_HOME respected" 'HOME=$T/x1 XDG_DATA_HOME=$T/x1/data dg init >/dev/null && [ -f "$T/x1/data/dgit/HEAD" ]'
ok "DGIT_DIR respected" 'HOME=$T/x2 DGIT_DIR=$T/x2/repo dg init >/dev/null && [ -f "$T/x2/repo/HEAD" ]'

section "Adding from inside and outside ~" 7
cd "$HOME/.config/nvim"; dg add init.lua >/dev/null
ok "relative add inside home" 'dg ls-files --full-name :/ | grep -qx .config/nvim/init.lua'
cd "$T/out"; echo o > "$T/out/x"
ok "outside home: relative add refused" '! dg add x >/dev/null && ! dg add .bashrc >/dev/null && ! dg add . >/dev/null'
ok "outside home: relative path refused for other commands" '! dg diff .bashrc >/dev/null && ! dg restore x >/dev/null'
ok "outside home: absolute path outside home rejected" '! dg add "$T/out/x" >/dev/null'
ok "outside home: nothing was staged" '[ "$(dg ls-files | wc -l)" = 1 ]'
ok "outside home: absolute path into home works" 'dg add "$HOME/.bashrc" >/dev/null && dg ls-files | grep -qx .bashrc'
ok "outside home: repo-wide commands work" 'dg status -s | grep -q .bashrc && dg commit -qm "x" --dry-run >/dev/null'

section "Paths that resolve outside ~" 9
# Any path that resolves outside ~ is refused, however it's written.
mkdir -p "$T/ext/proj"; git init -q "$T/ext/proj"; echo e > "$T/ext/proj/e"; X=$T/ext; cd "$HOME"
for c in "add $X/proj/e" "add $X/proj" "add /" "add ../ext/proj/e" "add .config/../../ext/proj" \
         "rm --cached $X/proj/e" "rm -r ../ext/proj"; do
  ok "outside ~ refused by dgit: $c" 'dg $c | grep -q "dgit only tracks files in your home"'
done
ok "outside ~: nothing tracked" '! dg ls-files | grep -q "^\.\./\|ext/"'
ok "inside ~ via .. still fine" 'dg add .config/../.config/nvim/init.lua >/dev/null'

section "Relative and absolute paths into ~" 8
# Relative and absolute are both fine wherever they resolve inside ~.
for f in .p1 .p2 .p3 .p4 .p5; do echo p > "$HOME/$f"; done
ok "inside ~: ./name" 'dg add ./.p1 >/dev/null && dg ls-files | grep -qx .p1'
ok "inside ~: absolute /..." 'dg add "$HOME/.p2" >/dev/null && dg ls-files | grep -qx .p2'
cd "$T"
ok "from the folder holding ~: relative into ~" 'dg add a/.p3 >/dev/null && dg ls-files --full-name :/ | grep -qx .p3'
ok "from the folder holding ~: ./ into ~" 'dg add ./a/.p4 >/dev/null && dg ls-files --full-name :/ | grep -qx .p4'
cd "$T/out"
ok "from outside: ../ climbing into ~" 'dg add ../a/.p5 >/dev/null && dg ls-files --full-name :/ | grep -qx .p5'
ok "from outside: ./name outside ~ refused" '! dg add ./x >/dev/null'
ok "from outside: non-path words pass untouched" '[ "$(dg config user.name)" = t ]'
cd "$HOME"
cd "$HOME/.config"; ok "relative .. that stays in ~ is fine" 'dg add ../.bashrc >/dev/null'; cd "$HOME"

section "Refused commands and protected paths" 20
cd "$HOME"
ok "untracked hidden from status -uall" '[ "$(dg status -s -uall | grep -c "^??")" = 0 ]'
for c in "add ." "add ./" "add $HOME" "add :/" \
         "add *.lua" "add .local/share/dgit" "add .local/share" "add .local/share/dgit/config" "add .config/../.local/share/dgit/HEAD" \
         "stash -a" "stash -ua" "stash push --all" "clean -fdx" "-c x.y=z clean -n" \
         "--no-pager clean -n"; do
  ok "refused: dgit $c" '! dg $c >/dev/null'
done
cd "$HOME/.config"; ok "refused: add .. from subdir" '! dg add .. >/dev/null'
cd "$HOME/.local/share/dgit"; ok "refused: add from inside repo" '! dg add config >/dev/null'
ok "allowed: add ~/.bashrc via .. from inside repo" 'dg add ../../../.bashrc >/dev/null'
cd "$HOME"
ok "nothing from the repo or junk staged" '! dg ls-files | grep -qE "^(\.local|junk)"'

section "Commit, push, status and stash" 5
dg add .config/nvim >/dev/null
ok "directory add" 'dg ls-files | grep -qx .config/nvim/lazy.json'
dg commit -qm one >/dev/null; dg remote add origin "$T/r.git"; dg push -q -u origin main >/dev/null
echo more >> "$HOME/.bashrc"
ok "tracked modification shown" 'dg status -s | grep -q "M .bashrc"'
ok "leading options pass through" 'dg --no-pager -c color.ui=never log --oneline | grep -q one'
dg commit -qam two
echo edit >> "$HOME/.bashrc"
ok "stash -u stashes only tracked changes" 'dg stash -u -q && [ -f "$HOME/junk" ] && dg stash pop -q'
ok "stash round trip kept edit" 'tail -1 "$HOME/.bashrc" | grep -qx edit'
dg commit -qam three

section "add --all and -A" 12
# add --all / -A stages tracked changes (edits and deletions), nothing new.
echo gone > "$HOME/.gone"; dg add .gone >/dev/null; dg commit -qm gone
echo e2 >> "$HOME/.bashrc"; rm "$HOME/.gone"; echo n > "$HOME/.newfile"
for c in "add --all" "add -A" "add -vA" "add --update" "add -u" "aa"; do
  dg reset -q
  ok "$c stages tracked edits and deletions" 'dg $c >/dev/null && [ "$(dg diff --cached --name-status | tr "\t\n" ": ")" = "M:.bashrc D:.gone " ]'
  ok "$c leaves untracked files alone" '! dg ls-files | grep -qE "^(\.newfile|junk)$"'
done
dg commit -qm all

section "Files inside project repos" 14
cd "$HOME/proj"; git init -q; mkdir sub; echo p > p.txt; echo s > sub/s.txt; git add .; git commit -qm p
ok "hook env vars ignored" '[ "$(GIT_DIR=$PWD/.git GIT_INDEX_FILE=$PWD/.git/index dg ls-files --full-name :/ | grep -c p.txt)" = 0 ]'

# Files inside a project's own repo, under home.
dg add p.txt >/dev/null; cd sub; dg add s.txt >/dev/null; cd ..
ok "nested repo: files stored by path from home" 'dg ls-files --full-name :/ | grep -qx proj/p.txt && dg ls-files --full-name :/ | grep -qx proj/sub/s.txt'
mkdir -p sub/deep; echo d > "sub/deep/d 1.txt"; echo t > top.txt
dg add sub >/dev/null
ok "nested repo: dir add expands to files" 'dg ls-files --full-name :/ | grep -qx "proj/sub/deep/d 1.txt"'
ok "nested repo: dir add stays in that dir" '! dg ls-files --full-name :/ | grep -qx proj/top.txt'
dg add . >/dev/null
ok "nested repo: add . from project root" 'dg ls-files --full-name :/ | grep -qx proj/top.txt'
ok "nested repo: .git never staged" '! dg ls-files --full-name :/ | grep -q "proj/\.git/"'
echo a > abs.txt; cd "$T/out"
ok "nested repo: absolute path from outside home" 'dg add "$HOME/proj/abs.txt" >/dev/null && dg ls-files | grep -qx proj/abs.txt'
cd "$HOME/proj"
ok "nested repo: options with dir refused" '! dg add -v sub >/dev/null'
cd "$HOME"; mkdir -p "$HOME/.config/plug/repo"; echo pc > "$HOME/.config/plug/plug.conf"
git init -q "$HOME/.config/plug/repo"; echo rf > "$HOME/.config/plug/repo/r.txt"
git -C "$HOME/.config/plug/repo" add .; git -C "$HOME/.config/plug/repo" commit -qm r
dg add .config/plug >/dev/null
ok "dir holding a repo: expands to files" 'dg ls-files | grep -qx .config/plug/plug.conf && dg ls-files | grep -qx .config/plug/repo/r.txt'
ok "no gitlinks or .git staged" '! dg ls-files -s | grep -q ^160000 && ! dg ls-files | grep -q "repo/\.git"'
dg commit -qm nested; echo e >> "$HOME/proj/p.txt"
ok "nested repo: edits seen" 'dg status -s | grep -q "M proj/p.txt"'
ok "nested repo: add -A stages tracked edits" 'dg add -A >/dev/null && dg diff --cached --name-only | grep -qx proj/p.txt'
dg reset -q
ok "nested repo: commit -a picks up edits" 'dg commit -qam e && [ -z "$(dg status -s)" ]'
dg push -q
cd "$HOME/proj"
ok "project repo sees only its own change" '[ "$(git status -s -uno)" = " M p.txt" ] && [ "$(git ls-files | wc -l)" = 2 ]'

section "rm protection for project repos" 11
# rm must not delete files that belong to a project's repo; untracking is fine.
ok "rm refused for a file in a project repo" '! dg rm -q top.txt >/dev/null && [ -f top.txt ] && dg ls-files | grep -qx top.txt'
ok "rm -r refused for a dir in a project repo" '! dg rm -q -r sub >/dev/null && [ -f sub/s.txt ]'
cd "$HOME"
ok "rm -r refused for a dir holding a project repo" '! dg rm -q -r proj >/dev/null && [ -f proj/p.txt ]'
ok "rm pattern refused when it reaches a project repo" '! dg rm -q "proj/*.txt" >/dev/null && [ -f proj/top.txt ]'
ok "rm refused inside a nested plugin repo" '! dg rm -q .config/plug/repo/r.txt >/dev/null && [ -f .config/plug/repo/r.txt ]'
ok "rm -n (dry run) allowed" 'dg rm -q -n proj/top.txt >/dev/null && dg ls-files | grep -qx proj/top.txt'
ok "rm --cached untracks and keeps project file" 'dg rm -q --cached proj/top.txt && [ -f proj/top.txt ] && ! dg ls-files | grep -qx proj/top.txt'
ok "rm --cached via alias allowed" 'dg untrack -q proj/sub/deep/"d 1.txt" && [ -f "proj/sub/deep/d 1.txt" ]'
ok "plain rm next to (not in) a repo still deletes" 'dg rm -q .config/plug/plug.conf && [ ! -e .config/plug/plug.conf ]'
echo r > .rmme; dg add .rmme >/dev/null; dg commit -qm rmme
ok "plain rm of an ordinary dotfile deletes it" 'dg rm -q .rmme && [ ! -e .rmme ] && ! dg ls-files | grep -qx .rmme'
dg commit -qm rms; dg push -q; cd "$HOME/proj"
cd "$HOME"; ok "plain git in home sees no repo" '! git status >/dev/null 2>&1'

section "Clone onto a second machine" 10
# Second machine: clone onto an existing file.
echo mine > "$T/b/.bashrc"
mkdir -p "$T/b/.config/nvim"; dg show HEAD:.config/nvim/init.lua > "$T/b/.config/nvim/init.lua"
out=$(HOME=$T/b dg clone "$T/r.git")
ok "clone onto existing files succeeds" '[ $? -eq 0 ]'
ok "clone kept differing local file" '[ "$(cat "$T/b/.bashrc")" = mine ]'
ok "clone lists only files that differ" 'echo "$out" | grep -q "~/.bashrc" && ! echo "$out" | grep -q init.lua'
ok "clone wrote files that were missing" '[ -f "$T/b/.config/nvim/lazy.json" ]'
ok "differing file shows as modified" 'HOME=$T/b dg status -s | grep -q "M .bashrc" && [ "$(HOME=$T/b dg status -s | wc -l)" = 1 ]'
mkdir "$T/m"; dg show HEAD:.bashrc > "$T/m/.bashrc"
ok "clone onto identical files is silent and clean" '[ "$(HOME=$T/m dg clone "$T/r.git" | wc -l)" = 1 ] && [ -z "$(HOME=$T/m dg status -s)" ]'
(cd "$T/b" && HOME=$T/b dg checkout -- .bashrc >/dev/null)
ok "checkout -- file takes repo version" '[ "$(head -1 "$T/b/.bashrc")" = b ]'
ok "clone tracks upstream" 'HOME=$T/b dg status -sb | grep -q "origin/main"'
ok "clone wrote no repo internals" '[ -f "$T/b/.local/share/dgit/ignore" ] && HOME=$T/b dg config remote.origin.url >/dev/null'
ok "clone recreates nested paths" '[ "$(cat "$T/b/proj/sub/s.txt")" = s ]'

section "Pull collisions" 3
# Incoming file collides with a local untracked one.
echo v > "$HOME/.vimrc"; dg add .vimrc >/dev/null; dg commit -qm v; dg push -q
echo precious > "$T/b/.vimrc"
ok "pull refuses to clobber" '! HOME=$T/b dg pull -q >/dev/null && [ "$(cat "$T/b/.vimrc")" = precious ]'
ok "aliased pull refuses to clobber" '! HOME=$T/b dg up -q >/dev/null && [ "$(cat "$T/b/.vimrc")" = precious ]'
rm "$T/b/.vimrc"
ok "pull works once moved" 'HOME=$T/b dg pull -q >/dev/null && [ "$(cat "$T/b/.vimrc")" = v ]'

section "Files matched by other ignore rules" 4
# Files that some other ignore rule matches (a project's .gitignore, the
# global excludes file) must be protected too.
cd "$HOME/proj"; echo .env > .gitignore; echo A-env > .env
dg add .env >/dev/null; dg commit -qm ignored; dg push -q
mkdir -p "$T/b/proj"; echo .env > "$T/b/proj/.gitignore"; echo B-env > "$T/b/proj/.env"
ok "pull won't clobber files a .gitignore matches" '! HOME=$T/b dg pull -q >/dev/null 2>&1 && [ "$(cat "$T/b/proj/.env")" = B-env ]'
rm "$T/b/proj/.env"
ok "pull proceeds once moved" 'HOME=$T/b dg pull -q >/dev/null && [ "$(cat "$T/b/proj/.env")" = A-env ]'
echo A-s > k.secret; dg add k.secret >/dev/null; dg commit -qm secret; dg push -q
HOME=$T/b dg fetch -q; echo B-s > "$T/b/proj/k.secret"
ok "cherry-pick won't clobber files global excludes match" '! HOME=$T/b dg cherry-pick origin/main >/dev/null 2>&1 && [ "$(cat "$T/b/proj/k.secret")" = B-s ]'
mkdir -p "$T/c/proj"; echo .env > "$T/c/proj/.gitignore"; echo C-env > "$T/c/proj/.env"
ok "clone won't clobber files a .gitignore matches" 'HOME=$T/c dg clone "$T/r.git" >/dev/null 2>&1 && [ "$(cat "$T/c/proj/.env")" = C-env ]'
cd "$HOME"

section "Pull contacts the remote once" 14
# Each connection to the remote runs its upload-pack; count them.
printf '#!/bin/sh\necho . >> "%s"\nexec git upload-pack "$@"\n' "$T/contacts" > "$T/up.sh"; chmod +x "$T/up.sh"
mkdir "$T/p"; HOME=$T/p dg clone "$T/r.git" >/dev/null 2>&1
P() { HOME=$T/p dg "$@"; }
P config remote.origin.uploadpack "$T/up.sh"
contacts() { local n=0; [ -f "$T/contacts" ] && n=$(wc -l < "$T/contacts"); rm -f "$T/contacts"; echo $((n)); }
push_new() { echo "$1" > "$HOME/$2"; dg add "$2" >/dev/null; dg commit -qm "$1"; dg push -q; }
push_new p1 .pull1
ok "plain pull fast-forwards" 'P pull -q >/dev/null && [ "$(cat "$T/p/.pull1")" = p1 ]'
ok "plain pull contacts the remote once" '[ "$(contacts)" = 1 ]'
ok "pull with nothing new is up to date" 'P pull | grep -q "Already up to date"'
ok "pull with nothing new contacts it once" '[ "$(contacts)" = 1 ]'
push_new p2 .pull2
ok "pull --ff-only fast-forwards, contacting once" 'P pull --ff-only -q >/dev/null && [ -f "$T/p/.pull2" ] && [ "$(contacts)" = 1 ]'
ok "pull is recorded as a pull" 'P reflog -1 --format=%gs | grep -q "^pull"'
echo l > "$T/p/.local1"; P add "$T/p/.local1" >/dev/null; P commit -qm local1
ok "only ahead: up to date, as git pull says" 'P pull | grep -q "Already up to date" && [ "$(contacts)" = 1 ]'
push_new p3 .pull3  # now both sides have moved on
P config pull.ff only
ok "diverged, pull.ff=only: refuses, as git pull does" '! P pull -q >/dev/null 2>&1 && [ ! -f "$T/p/.pull3" ] && [ "$(contacts)" = 1 ]'
P config --unset pull.ff
ok "diverged, no settings: git pull decides, and refuses" '! P pull -q >/dev/null 2>&1 && [ ! -f "$T/p/.pull3" ] && [ "$(contacts)" = 2 ]'
ok "diverged, --no-rebase: git pull's merge commit" 'P pull -q --no-rebase >/dev/null && [ -f "$T/p/.pull3" ] && P log -1 --format=%s | grep -q "^Merge branch .main. of "'
ok "diverged, --no-rebase: contacts it once" '[ "$(contacts)" = 1 ]'
P reset -q --hard origin/main
push_new p4 .pull4; P config pull.rebase true
ok "pull.rebase still runs git pull, and works" 'P pull -q >/dev/null 2>&1 && [ -f "$T/p/.pull4" ] && [ "$(contacts)" = 2 ]'
P config --unset pull.rebase; push_new p5 .pull5
ok "aliased pull still runs git pull, and works" 'P up -q >/dev/null 2>&1 && [ -f "$T/p/.pull5" ] && [ "$(contacts)" = 2 ]'
push_new p6 .pull6
ok "pull with arguments still runs git pull, and works" 'P pull -q origin main >/dev/null 2>&1 && [ -f "$T/p/.pull6" ] && [ "$(contacts)" = 2 ]'

section "Deletions and paths starting with -" 3
# Deleting a tracked file inside a project repo, then adding it, stages the deletion.
rm "$HOME/proj/abs.txt"; cd "$HOME/proj"
ok "nested repo: add of deleted file stages removal" 'dg add abs.txt >/dev/null && ! dg ls-files | grep -qx abs.txt'
mkdir ./-d; echo d > ./-d/f; echo s > stray.txt
ok "nested repo: dir starting with - after --" 'dg add -- -d >/dev/null && dg ls-files | grep -qx -- -d/f && ! dg ls-files | grep -qx stray.txt'
cd "$HOME"; echo dash > "$HOME/-dash"
ok "path starting with - after --" 'dg add -- -dash >/dev/null && dg ls-files | grep -qx -- -dash'

section "Option guards, aliases and wrappers" 8
ok "refused: -C elsewhere" '! dg -C "$T" status >/dev/null'
ok "refused: --git-dir override" '! dg --git-dir="$T/r.git" log >/dev/null'
ok "shell alias runs" '[ "$(dg sh)" = hi ]'
ok "shell alias reading settings works" 'dg shlist | grep -q "^alias.sh "'
ok "shell alias can't reach the dotfiles repo" '! dg shstat >/dev/null && dg shstat | grep -q "not a git repository"'
cd "$HOME/.config"
ok "shell alias can't reach it from a subfolder either" '! dg shstat >/dev/null'
cd "$HOME"
# A git() wrapper that hands home-dir commands to dgit, exported into the
# environment, must not make dgit call itself.
git() { if [ "$PWD" = "$HOME" ]; then "$BASH" "$D" "$@"; else command git "$@"; fi; }
export -f git
ok "exported git() wrapper doesn't recurse" 'within 20 "$BASH" "$D" status -s >/dev/null 2>&1'
unset -f git
# Case-insensitive filesystems: a differently-cased path to home is still home.
lc=$(printf %s "$HOME" | tr '[:upper:]' '[:lower:]'); uc=$(printf %s "$HOME" | tr '[:lower:]' '[:upper:]')
if [ "$uc" != "$HOME" ] && [ "$uc" -ef "$HOME" ]; then
  cd "$uc/.config"; ok "differently-cased cwd counts as inside home" 'dg add nvim/init.lua >/dev/null'; cd "$HOME"
else  # Still a test, so the section's count is the same on every filesystem
  ok "differently-cased cwd counts as inside home (case-sensitive filesystem: nothing to test)" true
fi

section "Stash pop and the ignore file" 2
# stash pop runs unignored; it must not list all of $HOME.
echo junk > "$T/b/junk"; echo z >> "$T/b/.vimrc"
HOME=$T/b dg stash -q
ok "stash pop output stays small" '[ "$(HOME=$T/b dg stash pop | grep -c junk)" = 0 ]'

# Self-heal a missing ignore file.
rm "$HOME/.local/share/dgit/ignore"
ok "ignore file recreated" 'dg status >/dev/null; [ -f "$HOME/.local/share/dgit/ignore" ]'

section "Edge cases" 9
git init -q --bare "$T/empty.git"; mkdir "$T/e"
ok "empty clone succeeds" 'HOME=$T/e dg clone "$T/empty.git" >/dev/null'
ok "clone extra args rejected" '! HOME=$T/x dg clone "$T/r.git" extra >/dev/null'
ok "HOME unset rejected" '! env -u HOME "$BASH" "$D" status >/dev/null 2>&1'
ok "help" 'dg | grep -q "dgit init"'
ok "--version passes through" 'dg --version | grep -q "git version"'
mkdir "$T/hlp"
ok "<command> --help is git's help, not the command (init makes no repo)" 'HOME=$T/hlp dg init --help >/dev/null 2>&1; [ ! -e "$T/hlp/.local/share/dgit" ]'
ok "--help reaches git even for refused commands" '! dg clean --help 2>&1 | grep -q refusing'
ok "a lone <command> -h shows git's usage" 'dg add -h | grep -q "usage: git add"'
ok "-h with more arguments stays an option (grep -h)" 'out=$(dg grep -h -e more -- .bashrc) && [ -n "$out" ] && ! printf %s "$out" | grep -q "^\.bashrc:"'

section ""
echo
if [ $fail -eq 0 ]; then
  echo "${c_ok}All $pass tests passed${c_off} in ${SECONDS}s."
else
  echo "${c_bad}$fail of $((pass + fail)) tests failed${c_off} in ${SECONDS}s."
fi
if [ $miscounts -gt 0 ]; then
  echo "${c_bad}$miscounts section count$([ $miscounts -eq 1 ] || echo s) wrong: update the section line$([ $miscounts -eq 1 ] || echo s) shown above.${c_off}"
fi
[ $fail -eq 0 ] && [ $miscounts -eq 0 ]
