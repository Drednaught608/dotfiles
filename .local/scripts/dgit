#!/usr/bin/env bash
# dgit - Dotfiles Git, a minimal dotfiles manager for $HOME.
#
#   dgit init            create the repo
#   dgit clone <url>     clone dotfiles and check them out into $HOME
#   dgit add <path>...   start tracking files (everything else is ignored)
#   dgit <git args...>   any other git command, run against $HOME
#   dgit test            run dgit's test suite
#
# The repo lives in $DGIT_DIR (default: ~/.local/share/dgit). Paths may be
# relative or absolute and are stored by their path from ~; any path that
# resolves outside ~ is refused.

[ -n "$HOME" ] || { echo "dgit: HOME is not set" >&2; exit 1; }
DGIT_DIR=${DGIT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/dgit}

# Git exports these in hooks and some tools set them; any one left in the
# environment would point dgit at another repo's index, objects or config.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_CONFIG GIT_CONFIG_COUNT \
  GIT_CONFIG_PARAMETERS GIT_IMPLICIT_WORK_TREE GIT_GRAFT_FILE GIT_PREFIX \
  GIT_NO_REPLACE_OBJECTS GIT_REPLACE_REF_BASE GIT_SHALLOW_FILE GIT_NAMESPACE \
  GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS

# Use the real commands, never shell functions exported under their names
# (a git() wrapper that calls dgit would otherwise make dgit call itself).
unset -f git find xargs sed

# Are we inside $HOME? Compare directories by identity, not spelling: case,
# symlinks and C:/Users/x vs /c/users/x on Windows can all differ.
here=$PWD inside= d=$PWD
while :; do
  [ "$d" -ef "$HOME" ] && { inside=1; break; }
  [ "${d%/*}" = "$d" ] && break
  d=${d%/*}
done

# This script's own path, fixed before the cd below can break a relative $0.
case $0 in /*|?:*) self=$0 ;; *) self=$here/$0 ;; esac

# Stay put inside $HOME so relative paths work; otherwise operate from ~.
cd "$HOME" || exit
HOME=$PWD
[ -n "$inside" ] && cd "$here"
case $DGIT_DIR in /*|?:*) ;; *) DGIT_DIR=$here/$DGIT_DIR ;; esac

die() { echo "dgit: $*" >&2; exit 1; }

# Does path $1 (relative to where you are) lead somewhere inside $HOME?
# Resolve . and .. by name, then compare directories by identity.
inhome() {
  local IFS=/ p=$1 c parts out=() d
  case $p in /*|?:*) ;; *) p=$PWD/$p ;; esac
  read -ra parts <<< "$p"
  for c in "${parts[@]}"; do
    case $c in
      ''|.) ;;
      ..) [ ${#out[@]} -gt 0 ] && out=("${out[@]:0:${#out[@]}-1}") ;;
      *) out+=("$c") ;;
    esac
  done
  d=${out[*]}
  case $p in /*) d=/$d ;; esac
  while :; do
    [ "$d" -ef "$HOME" ] && return 0
    [ "${d%/*}" = "$d" ] && return 1
    d=${d%/*}
  done
}

# Leading git options (e.g. -c k=v, --no-pager) go before the command; split
# them off so the command itself is what decides how dgit runs it. Options
# that would point git at another directory or repo defeat dgit's purpose.
opts=()
while :; do
  case $1 in
    -h|--help) set -- help; break ;;
    -C|--git-dir*|--work-tree*|--bare|--namespace*) die "'$1' would point dgit away from $HOME and its repo" ;;
    -c) opts+=("$1" "$2"); shift; shift ;;
    -*) opts+=("$1"); shift ;;
    *) break ;;
  esac
done

# repo: git pointed at the dgit repo and $HOME (an array, so xargs can run it
# too). g: that, ignoring your global excludes and fsmonitor (which would
# watch all of $HOME). ig: same, but with every untracked file in $HOME
# ignored, so nothing outside what you've added is ever seen or swept up.
# The ignore file is (re)created on demand, so it can never silently vanish.
repo=(git --git-dir="$DGIT_DIR" --work-tree="$HOME")
g() {
  "${repo[@]}" -c status.showUntrackedFiles=no -c core.excludesFile= \
    -c core.fsmonitor=false "${opts[@]}" "$@"
}
ig() {
  [ -e "$DGIT_DIR/ignore" ] || { [ -d "$DGIT_DIR" ] && echo '*' > "$DGIT_DIR/ignore"; }
  g -c core.excludesFile="$DGIT_DIR/ignore" "$@"
}

# Aliases can't shadow built-in commands, so only look up unfamiliar ones
# (each lookup costs an extra git process), and classify an alias by the
# command it expands to.
cmd=$1 adef=
case $cmd in
  ''|init|clone|help|test|add|stash|clean|status|diff|log|show|commit|push|fetch|rm|mv|\
  restore|reset|branch|tag|remote|config|ls-files|ls-tree|grep|blame|reflog|\
  checkout|switch|merge|pull|rebase|cherry-pick|revert|am|bisect|rev-parse|rev-list|\
  show-ref|cat-file|describe|shortlog|format-patch|apply|notes|gc|fsck|\
  archive|difftool|mergetool|ls-remote|for-each-ref|check-ignore|version) ;;
  *)
    a=$(g config --get "alias.$cmd") && {
      a=${a#"${a%%[![:space:]]*}"}
      case $a in '!'*) die "alias '$cmd' runs a shell command, which dgit can't check; dgit doesn't run shell aliases" ;; esac
      adef=$a a=${a%%[[:space:]]*}
      # An add alias runs unforced, so it can only stage tracked changes.
      case $a in
        add) ;;
        stash|clean) die "alias '$cmd' runs '$a'; use 'dgit $a' directly" ;;
        *) cmd=$a ;;
      esac
    }
    ;;
esac

# Started outside $HOME, dgit runs from ~, so Git would read a relative path
# as relative to ~. Resolve it from where you actually are instead: if it
# leads into ~, pass it on as an absolute path; if it names something that
# resolves outside ~, refuse. Anything else (refs, messages) passes as is.
if [ -z "$inside" ]; then
  case $cmd in ''|init|clone|help|test) ;; *)
    args=("$1") skip=
    for a in "${@:2}"; do
      if [ -n "$skip" ]; then skip=
      else
        case $a in
          -m|--message|-[!-]*m) skip=1 ;;
          -*|/*|?:*) ;;
          *) if inhome "$here/$a"; then a=$here/$a
             elif [ -e "$here/$a" ] || [ -e "$a" ]; then
               die "'$a' resolves to $here/${a#./}, which is outside $HOME; dgit only works with files in your home"
             fi ;;
        esac
      fi
      args+=("$a")
    done
    set -- "${args[@]}"
  esac
fi

case $cmd in
  init)
    [ -e "$DGIT_DIR" ] && die "$DGIT_DIR already exists"
    git init -q --bare "$DGIT_DIR" || exit
    g config core.autocrlf false
    echo "dgit: initialized $DGIT_DIR"
    ;;
  clone)
    [ $# -eq 2 ] || { echo "usage: dgit clone <url>" >&2; exit 2; }
    [ -e "$DGIT_DIR" ] && die "$DGIT_DIR already exists"
    url=$2
    case $url in /*|?:*) ;; *) [ -e "$here/$url" ] && url=$here/$url ;; esac
    git clone -q --bare "$url" "$DGIT_DIR" || exit
    g config core.autocrlf false
    # A bare clone has no fetch refspec; add one so pull/fetch work normally.
    g config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
    g fetch -q origin
    g rev-parse -q --verify HEAD >/dev/null || { echo "dgit: cloned an empty repo; nothing to check out"; exit 0; }
    g branch -q -u "origin/$(g symbolic-ref --short HEAD)"
    # Never overwrite a file you already have: load the repo's file list,
    # write out only the files missing here, and leave the rest for review.
    g reset -q || exit
    g -C "$HOME" ls-files -z --deleted |
      xargs -0 "${repo[@]}" -C "$HOME" checkout -q -- || exit
    echo "dgit: dotfiles checked out into $HOME"
    g diff --quiet && exit
    echo "dgit: kept your existing files where they differ from the repo:"
    g -C "$HOME" diff --name-only | sed 's/^/  ~\//'
    echo "  Review with: dgit diff    Take the repo's version: dgit checkout -- <file>"
    ;;
  ''|help)
    [ ${#opts[@]} -gt 0 ] && [ -z "$cmd" ] && { g; exit; }
    [ $# -gt 1 ] && { git help "${@:2}"; exit; }
    sed -n '2,12s/^# \{0,1\}//p' "$self"
    ;;
  # The suite runs dgit against throwaway homes in a temp dir. Run it with
  # bash, so it works even where the file lost its executable bit.
  test)
    t=${self%/*}/tests/dgit-test
    [ -f "$t" ] || die "no test suite at $t"
    exec "$BASH" "$t"
    ;;
  # checkout through bisect (and stash apply/pop below) write incoming files
  # into $HOME. Git silently overwrites ignored files but refuses to clobber
  # untracked ones, so they run without dgit's ignore rule. A .gitignore inside $HOME (a project's own, say) can
  # still mark files ignored, so where Git allows it, say never to overwrite
  # ignored files either; pull can't, so it checks for collisions itself.
  checkout|switch)
    [ "$1" = "$cmd" ] && set -- "$1" --no-overwrite-ignore "${@:2}"
    g "$@"
    ;;
  merge)
    case " ${*:2} " in
      *" --abort "*|*" --continue "*|*" --quit "*) ;;
      *) [ "$1" = "$cmd" ] && set -- "$1" --no-overwrite-ignore "${@:2}" ;;
    esac
    g "$@"
    ;;
  # pull fetches first, to check what's incoming against your untracked
  # files. A plain merging pull then merges that fetch itself, so the remote
  # is contacted once; git pull would fetch all over again. Anything pull
  # treats specially (rebase, arguments, an alias, other pull.* settings,
  # no upstream) still runs the real git pull, as before.
  pull)
    pos=() skip= fast= ff= norebase= rspec= mflags=() fq=-q
    for a in "${@:2}"; do
      [ -n "$skip" ] && { skip=; continue; }
      case $a in -s|-X|-o|-j|--depth) skip=1 ;; -*) ;; *) pos+=("$a") ;; esac
    done
    if [ "$1" = pull ] && br=$(g symbolic-ref -q --short HEAD); then
      fast=1
      for a in "${@:2}"; do
        case $a in
          --ff|--no-ff|--ff-only) ff=$a ;;
          -q|--quiet|-v|--verbose) mflags+=("$a") ;;
          --no-rebase) norebase=1 rspec=1 ;;
          *) fast= ;;
        esac
      done
      # Apply pull's own settings the way git pull would; any it doesn't
      # merely pass to merge leaves the pull to git.
      shopt -s nocasematch
      while read -r k v; do
        case $k in
          pull.ff) [ -n "$ff" ] || case $v in
              only) ff=--ff-only ;;
              false|no|off|0) ff=--no-ff ;;
              ''|true|yes|on|1) ff=--ff ;;
              *) fast= ;;
            esac ;;
          pull.rebase|"branch.$br.rebase")
            [ -n "$norebase" ] || case $v in false|no|off|0) rspec=1 ;; *) fast= ;; esac ;;
          pull.*|submodule.recurse) fast= ;;
        esac
      done < <([ -z "$fast" ] || g config --get-regexp '^(pull\.|branch\..*\.rebase$|submodule\.recurse$)')
      shopt -u nocasematch
    fi
    [ -z "$fast" ] || case " ${mflags[*]} " in *" -q "*|*" --quiet "*) ;; *) fq= ;; esac
    g fetch $fq "${pos[@]}" || exit
    base=$(g merge-base HEAD FETCH_HEAD 2>/dev/null) || { fast=; base=$(g hash-object -t tree --stdin </dev/null); }
    # The first FETCH_HEAD line is the one to merge, unless marked not-for-merge.
    [ -z "$fast" ] || { IFS= read -r l < "$DGIT_DIR/FETCH_HEAD" && [[ $l == *$'\t\t'* ]]; } || fast=
    # Told neither rebase nor ff, git pull refuses to merge diverged
    # branches; unless this is a fast-forward or there's nothing to do,
    # let it say so.
    [ -z "$fast" ] || [ -n "$rspec" ] || [ -n "$ff" ] ||
      [ "$base" = "$(g rev-parse -q --verify HEAD)" ] || [ "$base" = "${l%%$'\t'*}" ] || fast=
    bad=()
    while IFS= read -r -d '' p; do
      { [ -e "$HOME/$p" ] || [ -L "$HOME/$p" ]; } &&
        ! g -C "$HOME" --literal-pathspecs ls-files --error-unmatch -- "$p" >/dev/null 2>&1 &&
        bad+=("$p")
    done < <(g diff -z --name-only --no-renames --diff-filter=A "$base" FETCH_HEAD)
    [ ${#bad[@]} -eq 0 ] ||
      die "pulling would overwrite these untracked files; move them aside first:$(printf '\n  ~/%s' "${bad[@]}")"
    if [ -n "$fast" ]; then
      GIT_REFLOG_ACTION=pull g merge --no-overwrite-ignore $ff "${mflags[@]}" FETCH_HEAD
    else
      g "$@"
    fi
    ;;
  rebase|cherry-pick|revert|am|reset|bisect)
    g "$@"
    ;;
  stash)
    case $2 in apply|pop|branch) g "$@"; exit ;; esac
    for a in "${@:2}"; do
      case $a in
        --) break ;;
        --all) die "refusing 'stash $a': it would stash away all of $HOME" ;;
        --*) ;;
        -*a*) die "refusing 'stash $a': it would stash away all of $HOME" ;;
      esac
    done
    ig "$@"
    ;;
  clean)
    die "refusing 'clean': with -x it would delete all of $HOME"
    ;;
  # A file inside a project's own repo belongs to that project too; deleting
  # it from disk would reach into the project. Only untracking is allowed
  # there (rm --cached), so ask git which files this rm would delete.
  rm)
    keep= end= paths=()
    case " $adef " in *" --cached "*|*" -n "*|*" --dry-run "*) keep=1 ;; esac
    for a in "${@:2}"; do
      case $end$a in
        --) end=1 ;;
        --cached|-n|--dry-run) keep=1 ;;
        --pathspec-from-file*) [ -n "$keep" ] || die "use 'rm --cached' with $a, or name the files" ;;
        -*) ;;
        *) inhome "$a" || die "refusing 'rm $a': it is outside $HOME, and dgit only tracks files in your home"
           paths+=("$a") ;;
      esac
    done
    if [ -z "$keep" ] && [ ${#paths[@]} -gt 0 ]; then
      pd=
      while IFS= read -r -d '' p; do
        case $p in */*) d=$HOME/${p%/*} ;; *) continue ;; esac
        [ "$d" = "$pd" ] && continue
        pd=$d
        while ! [ "$d" -ef "$HOME" ] && [ "${d%/*}" != "$d" ]; do
          [ -e "$d/.git" ] &&
            die "refusing to delete ~/$p: it belongs to the Git repo at ~/${d#"$HOME"/} too; use 'dgit rm --cached' to stop tracking it and keep the file"
          d=${d%/*}
        done
      done < <(g ls-files -z --full-name -- "${paths[@]}")
    fi
    ig "$@"
    ;;
  # Adding a path is the explicit opt-in, so force past the ignore rule; but
  # never for anything outside $HOME, all of it, or the repo itself.
  # Pathspecs are literal, so no glob or :/ magic can reach across $HOME.
  # With nothing new ever eligible, --all/-A means what --update means:
  # stage edits and deletions of tracked files. Run it as exactly that.
  add)
    flags=() paths=() nfiles=() ndirs=() end=
    for a in "${@:2}"; do
      case $end$a in
        --) end=1; continue ;;
        --pathspec-from-file*) die "refusing 'add $a': it could stage all of $HOME" ;;
        --all|--no-ignore-removal) flags+=(-u); continue ;;
        --*) flags+=("$a"); continue ;;
        -*A*) a=${a//A/}; [ "$a" = - ] || flags+=("$a"); flags+=(-u); continue ;;
        -*) flags+=("$a"); continue ;;
      esac
      case $a in -*) a=./$a ;; esac  # a path after --; keep it from reading as an option
      inhome "$a" || die "refusing 'add $a': it is outside $HOME, and dgit only tracks files in your home"
      [ "$a" -ef "$HOME" ] && die "refusing 'add $a': that is all of $HOME; name files explicitly"
      # Walk up from the repo (does $a contain it?) and from $a (is it
      # inside the repo, or inside some project's own Git repo?), comparing
      # by identity, not spelling.
      d=$DGIT_DIR
      while [ "${d%/*}" != "$d" ] && ! [ "$d" -ef "$HOME" ]; do
        [ "$a" -ef "$d" ] && die "refusing 'add $a': it contains the dgit repo"
        d=${d%/*}
      done
      proj=
      case $a in /*|?:*) d=$a ;; *) d=$PWD/$a ;; esac
      while [ "${d%/*}" != "$d" ] && ! [ "$d" -ef "$HOME" ]; do
        [ "$d" -ef "$DGIT_DIR" ] && die "refusing 'add $a': it is inside the dgit repo"
        [ -z "$proj" ] && [ -e "$d/.git" ] && proj=$d
        d=${d%/*}
      done
      # Git won't add files from inside another repo (it would link the repo
      # instead), so stage those directly, by name. A directory that is in,
      # or holds, a repo is expanded to its files, minus any .git.
      if [ -d "$a" ]; then
        if [ -n "$proj" ] || [ -n "$(find "$a" -name .git -print -quit)" ]; then
          ndirs+=("$a")
        else
          paths+=("$a")
        fi
      elif [ -n "$proj" ]; then
        nfiles+=("$a")
      else
        paths+=("$a")
      fi
    done
    if [ ${#nfiles[@]} -gt 0 ] || [ ${#ndirs[@]} -gt 0 ]; then
      [ ${#flags[@]} -eq 0 ] || die "options can't be combined with files inside another Git repo"
      # --remove stages a deletion when a tracked file is gone.
      if [ ${#nfiles[@]} -gt 0 ]; then
        g update-index --add --remove -- "${nfiles[@]}" || exit
      fi
      # Pass paths as arguments, not stdin: Git for Windows only translates
      # /c/... style paths when they arrive as arguments.
      if [ ${#ndirs[@]} -gt 0 ]; then
        find "${ndirs[@]}" -name .git -prune -o \( -type f -o -type l \) -print0 |
          xargs -0 "${repo[@]}" update-index --add -- || exit
      fi
      [ ${#paths[@]} -gt 0 ] || exit 0
    fi
    ig --literal-pathspecs add -f "${flags[@]}" -- "${paths[@]}"
    ;;
  *)
    ig "$@"
    ;;
esac
