# IDE folders: JetBrains (cmake-build-*/ is CLion's builds), Visual Studio, Xcode's per-user data
.idea/
cmake-build-*/
.vs/
xcuserdata/

# .vim/ folders
.vim/

# language cache folders
__pycache__/
node_modules/
.venv/
venv/
.tox/
*.egg-info/
.ipynb_checkpoints/
*.pyc
*.pyo

# Build leftovers: CMake run in the source folder, Terraform's providers
CMakeFiles/
CMakeCache.txt
.terraform/

# Hidden caches (.cache/, .pytest_cache/, .mypy_cache/, .ruff_cache/, .eslintcache, ...)
.*cache

# Vim swap files
.*.sw*

# Editor backups & temporary files
*~
*.tmp

# ctags files: tags files only, in any folder; folders named tags (a site's tag pages) still count
.ctags
tags.temp
tags
!tags/

# Mac files
.DS_Store

# Windows files
Thumbs.db
desktop.ini

# Artifacts
*.exe

# Secrets that are never meant to be committed
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
.netrc
.git-credentials
.pgpass

# Misc.
.claude/
.misc/
