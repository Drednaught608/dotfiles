
" Vim Plug Setup {{{

    let sslVar = &ssl
    if sslVar ==# 1 && has('win64') || has('win32') || has('win16')
        set nossl
    endif

    let data_dir = has('nvim') ? stdpath('data') . '/site' : expand('~/.vim')
    let plugin_dir = data_dir . '/plugged/'

    " Install Plug package manager and sync plugin list
    if empty(glob(data_dir . '/autoload/plug.vim'))
        silent execute '!curl -sfLo '.data_dir.'/autoload/plug.vim --create-dirs  https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'

        if has("gui_running")
            autocmd GUIEnter * call PromptForPluginInstall()
            function! PromptForPluginInstall()
                redraw!
                let user_input = input('Doㅤyouㅤwantㅤtoㅤinstallㅤplugins?ㅤㅤㅤㅤㅤㅤㅤㅤㅤ(y/n):ㅤ')
                call feedkeys('\<C-Y>')
                if user_input ==# 'y' || user_input ==# 'Y'
                    autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
                else
                    source $MYVIMRC
                endif
            endfunction
        else
            let user_input = input('Do you want to install plugins? (y/n): ')
            call feedkeys('\<C-Y>')
            if user_input ==# 'y' || user_input ==# 'Y'
                autocmd VimEnter * PlugInstall --sync | source $MYVIMRC
            else
                source $MYVIMRC
            endif
        endif
    endif

    call plug#begin()

    Plug 'Raimondi/delimitMate'
    Plug 'markonm/traces.vim'
    Plug 'tpope/vim-commentary'
    Plug 'justinmk/vim-dirvish'
    Plug 'tpope/vim-fugitive'
    Plug 'airblade/vim-gitgutter'
    Plug 'ludovicchabant/vim-gutentags'
    Plug 'machakann/vim-highlightedyank'
    Plug 'RRethy/vim-illuminate'
    Plug 'google/vim-searchindex'
    Plug 'tpope/vim-sleuth'
    Plug 'tpope/vim-surround'

    call plug#end()

    let &ssl = sslVar

"}}}

" Settings / Definitions {{{

    " Settings
    if !empty(glob(plugin_dir . "vim-fugitive"))
        cabbrev git Git
        " Blame beside the file with both cursors on the same line; again to close it
        function! s:GitBlame() abort
            for win in range(1, winnr('$'))
                if getbufvar(winbufnr(win), '&filetype') ==# 'fugitiveblame'
                    execute win . 'close'
                    return
                endif
            endfor
            Git blame
            if &filetype !=# 'fugitiveblame'  " Fugitive gives no blame, silently, for an untracked file
                echohl ErrorMsg | echomsg 'No blame for ' . expand('%:t') . ': is it tracked by Git?' | echohl None
                return
            endif
            " Fugitive fits it to the details; at most half of what it and the file have
            execute 'vertical resize' min([winwidth(0), (winwidth(0) + winwidth(winnr('#'))) / 2])
            let w:blame_cursorbind = &l:cursorbind
            setlocal cursorbind
            augroup GitBlame
                autocmd! * <buffer>
                autocmd BufWinLeave <buffer> call s:GitBlameUnbind()
            augroup END
            wincmd p  " Back to the file
            let w:blame_cursorbind = &l:cursorbind
            setlocal cursorbind
        endfunction
        " However the blame closes (<Leader>gb, gq, :q), put back the windows' own cursorbind
        " (a diff keeps its own)
        function! s:GitBlameUnbind() abort
            for win in range(1, winnr('$'))
                let was = getwinvar(win, 'blame_cursorbind', -1)
                if was != -1
                    call setwinvar(win, '&cursorbind', was)
                    call setwinvar(win, 'blame_cursorbind', -1)
                endif
            endfor
        endfunction
    endif
    if !empty(glob(plugin_dir . "vim-gitgutter"))
        let g:gitgutter_map_keys = 0  " None of its own keys; mine are in Keymappings
    endif
    if !empty(glob(plugin_dir . "vim-searchindex"))
        set shortmess+=S
        " It maps * only if * has no mapping in any mode, and the .vimrc's Visual * blocks that:
        " give Normal mode * its version here (its <Plug> maps resolve once it has loaded)
        nmap * <Plug>ImprovedStar_*<Plug>SearchIndex
    endif
    if !empty(glob(plugin_dir . "vim-highlightedyank"))
        let g:highlightedyank_highlight_duration = 200
    endif
    if !empty(glob(plugin_dir . "vim-dirvish"))
        " Dirvish in place of netrw, with netrw's :Explore commands as netrw's code does them
        " (<Leader>e uses :Explore). Sizes: [N] or g:netrw_winsize (default 50), a percent of the
        " window, or lines/columns if negative. Sides: g:netrw_alto/altv ('splitbelow'/'splitright').
        let g:loaded_netrwPlugin = 1
        " gx opens the URL or file under the cursor; Vims from before 2025 had it from netrw
        if empty(globpath(&runtimepath, 'plugin/openPlugin.vim'))
            function! s:Gx() abort
                let url = matchstr(expand('<cWORD>'), '\%(\%(http\|ftp\|irc\)s\?\|file\)://\S\{-}\ze[^A-Za-z0-9/]*$')
                let opener = has('win32') || has('win32unix') ? 'explorer' : has('mac') ? 'open' : 'xdg-open'
                if !executable(opener)
                    echohl ErrorMsg | echomsg 'gx: ' . opener . ' not found' | echohl None
                    return
                endif
                call job_start([opener, empty(url) ? expand('<cfile>') : url],
                    \ {'stoponexit': '', 'in_io': 'null', 'out_io': 'null', 'err_io': 'null'})
            endfunction
            nnoremap <silent> gx :call <SID>Gx()<CR>
        endif
        function! s:Size(count, length) abort
            let size = a:count > 0 ? a:count : get(g:, 'netrw_winsize', 50)
            let size = size > 0 ? size * a:length / 100 : -size
            return size == 0 ? '' : size
        endfunction
        function! s:Explore(count, style, dir) abort
            let alto = get(g:, 'netrw_alto', &splitbelow)
            let altv = get(g:, 'netrw_altv', &splitright)
            if a:style =~# '^[SH]$\|^H!$'  " :Sex, :Hex: one side; :Hex!: the other
                let below = a:style ==# 'H!' ? !alto : alto
                execute 'noswapfile' (below ? 'below' : 'above') s:Size(a:count, winheight(0)) . 'wincmd s'
            else  " :Sex!, :Vex: one side; :Vex!: the other
                let right = a:style ==# 'V!' ? !altv : altv
                execute 'noswapfile' (right ? 'rightbelow' : 'leftabove') s:Size(a:count, winwidth(0)) . 'wincmd v'
            endif
            execute 'silent Dirvish' a:dir
        endfunction
        command! -bar -bang -count=0 -nargs=* -complete=dir Explore Dirvish <args>
        command! -bar -bang -count=0 -nargs=* -complete=dir Sexplore call s:Explore(<count>, 'S' . (<bang>0 ? '!' : ''), <q-args>)
        command! -bar -bang -count=0 -nargs=* -complete=dir Hexplore call s:Explore(<count>, 'H' . (<bang>0 ? '!' : ''), <q-args>)
        command! -bar -bang -count=0 -nargs=* -complete=dir Vexplore call s:Explore(<count>, 'V' . (<bang>0 ? '!' : ''), <q-args>)
        command! -bar -count=0 -nargs=* -complete=dir Texplore tab split | silent Dirvish <args>
        command! -bar -bang -count=0 -nargs=* -complete=dir Lexplore call s:Lexplore(<count>, <bang>0, <q-args>)
        " :Lex toggles a full-height drawer on the left (! on the right) on the working directory,
        " sized like the splits but from window 1; closing it saves its width in g:netrw_winsize,
        " as netrw does. :Lex [dir] while it's open shows [dir] in it. Enter in it opens a file in
        " the window beside it.
        function! s:Lexplore(count, right, dir) abort
            let drawer = 0
            for win in range(1, winnr('$'))
                if getwinvar(win, 'dirvish_drawer')
                    let drawer = win
                endif
            endfor
            if drawer && !empty(a:dir)
                execute drawer . 'wincmd w'
                execute 'silent Dirvish' a:dir
                wincmd p
            elseif drawer
                let g:netrw_winsize = -winwidth(drawer)
                execute drawer . 'close'
            else
                execute (a:right ? 'botright' : 'topleft') 'vertical' s:Size(a:count, winwidth(1)) 'new'
                let w:dirvish_drawer = 1
                setlocal winfixwidth
                execute 'silent Dirvish' (empty(a:dir) ? fnameescape(getcwd()) : a:dir)
            endif
        endfunction
        function! s:DirvishOpen() abort
            if !empty(get(w:, 'dirvish_drawer', '')) && !isdirectory(getline('.'))
                call dirvish#open('p', 0)
            else
                call dirvish#open('edit', 0)
            endif
        endfunction
        augroup DirvishSettings
            autocmd!
            autocmd FileType dirvish nnoremap <buffer><silent> <CR> :<C-U>call <SID>DirvishOpen()<CR>
            " Unlist a listing once you leave it; Dirvish keeps one listed if it's the only buffer
            autocmd BufLeave * if exists('b:dirvish') | setlocal nobuflisted | endif
        augroup END
    endif
    if !empty(glob(plugin_dir . "vim-gutentags"))
        let g:gutentags_cache_dir = expand('~/.vim/tags')
        let g:gutentags_ctags_exclude = [
              \ 'node_modules', '.git', '.hg', '.svn',
              \ 'dist', 'build', 'out', 'coverage', 'target',
              \ '.next', '.nuxt', '.svelte-kit', '.turbo', '.cache', '.parcel-cache',
              \ 'vendor', 'venv', '.venv', 'env', '__pycache__', '.pytest_cache', '.mypy_cache', '.tox',
              \ 'bin', 'obj',
              \ '.idea', '.vscode', '.vs',
              \ 'tmp', 'temp', 'logs',
              \ '*.min.js', '*.min.css', '*.map',
              \ '*.lock', 'package-lock.json', 'yarn.lock', 'pnpm-lock.yaml', 'Cargo.lock', 'poetry.lock',
              \ '*.log',
              \ '*.svg', '*.png', '*.jpg', '*.jpeg', '*.gif', '*.ico', '*.woff', '*.woff2', '*.ttf',
              \ '*.zip', '*.tar', '*.gz', '*.rar',
              \ '*.pyc', '*.pyo', '*.class', '*.o', '*.so', '*.dll', '*.exe',
              \ ]
        if !isdirectory(g:gutentags_cache_dir)
            call mkdir(g:gutentags_cache_dir, 'p')
        endif
        if has('win32')
            " The MinGW ctags first on PATH sorts with an external sort, which is Windows'
            " sort.exe outside Git Bash and fails: use scoop's, which sorts internally
            let g:gutentags_ctags_executable = expand('~') . '/scoop/apps/universal-ctags/current/ctags.exe'
        endif
    endif
    if !empty(glob(plugin_dir . "vim-sleuth"))
        " Sleuth sets 'tabstop' to 8 in files mixing tab- and space-indented lines unless
        " given a default: give it ours (a file's modeline or .editorconfig still wins). All
        " three are spelled out, as a tabstop alone would imply noexpandtab for new files.
        augroup SleuthDefaults
            autocmd!
            autocmd BufNewFile,BufReadPre * let b:sleuth_defaults = printf('tabstop=%d shiftwidth=%d %sexpandtab',
                \ &g:tabstop, &g:shiftwidth, &g:expandtab ? '' : 'no')
        augroup END
    endif

